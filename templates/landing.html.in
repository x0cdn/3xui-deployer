<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@TITLE@</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0f1115; color: #e6e6e6;
           display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
    .card { text-align: center; padding: 2rem 3rem; border: 1px solid #2a2d35; border-radius: 12px;
            background: #16181e; }
    h1 { font-size: 1.4rem; margin: 0 0 .5rem; }
    p { color: #9aa0aa; margin: .25rem 0; }
  </style>
</head>
<body>
  <div class="card">
    <h1>@TITLE@</h1>
    <p>It works.</p>
  </div>
</body>
</html>