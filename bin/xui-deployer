#!/usr/bin/env bash
set -euo pipefail

STATE_JSON="/etc/xui-deployer/state.json"
STATE_ENV="/etc/xui-deployer/state.env"
XUI_ENV="/etc/x-ui/install-result.env"
RESULT="/root/xui-deployer.txt"

HOST=""; DOMAIN=""; XHTTP_SUB=""; PROTOCOLS=""; SSH_PORT=""
PANEL_PORT=""; PANEL_PATH=""; PANEL_USER=""; SUBID=""; SUB_URL=""
SUB_LINK=""; PANEL_URL=""; REALITY_SNI=""; CLIENT_SUB_ACTIVE="no"; DEPLOYED_AT=""
XUI_VERSION="v3.11.0"
XUI_INSTALL_SHA256="9684bae4f769b2127fcceceb4f200045657381311867529e6ba76c6b58e2825d"

[[ $EUID -eq 0 ]] || { echo "Нужен root: sudo xui-deployer $*" >&2; exit 1; }

load_env_keys() {
  local file="$1"; shift
  [[ -f $file ]] || return 0
  local -A allow=()
  local key
  for key in "$@"; do allow[$key]=1; done
  local line k v
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    k="${BASH_REMATCH[1]}"
    v="${BASH_REMATCH[2]%$'\r'}"
    [[ -n ${allow[$k]:-} ]] || continue
    if [[ ${#v} -ge 2 && ( ${v:0:1} == '"' || ${v:0:1} == "'" ) && ${v: -1} == "${v:0:1}" ]]; then
      v="${v:1:${#v}-2}"
    fi
    printf -v "$k" '%s' "$v"
  done < "$file"
  return 0
}

load_state() {
  if [[ -f $STATE_JSON ]]; then
    local key val
    while IFS=$'\t' read -r key val; do
      case "$key" in
        host) HOST="$val" ;;
        domain) DOMAIN="$val" ;;
        xhttp_sub) XHTTP_SUB="$val" ;;
        protocols) PROTOCOLS="$val" ;;
        ssh_port) SSH_PORT="$val" ;;
        panel_port) PANEL_PORT="$val" ;;
        panel_path) PANEL_PATH="$val" ;;
        panel_user) PANEL_USER="$val" ;;
        subid) SUBID="$val" ;;
        sub_url) SUB_URL="$val" ;;
        sub_link) SUB_LINK="$val" ;;
        panel_url) PANEL_URL="$val" ;;
        reality_sni) REALITY_SNI="$val" ;;
        client_sub_active) CLIENT_SUB_ACTIVE="$val" ;;
        xui_version) XUI_VERSION="$val" ;;
        xui_install_sha) XUI_INSTALL_SHA256="$val" ;;
        deployed_at) DEPLOYED_AT="$val" ;;
      esac
    done < <(jq -r 'to_entries[] | [(.key | tostring), ((.value // "") | tostring)] | @tsv' "$STATE_JSON" 2>/dev/null || true)
  elif [[ -f $STATE_ENV ]]; then
    load_env_keys "$STATE_ENV" HOST DOMAIN XHTTP_SUB PROTOCOLS SSH_PORT PANEL_PORT \
      PANEL_PATH PANEL_USER SUBID SUB_URL SUB_LINK PANEL_URL REALITY_SNI \
      CLIENT_SUB_ACTIVE DEPLOYED_AT XUI_VERSION XUI_INSTALL_SHA256
  fi
  load_env_keys "$XUI_ENV" XUI_USERNAME XUI_PASSWORD XUI_PANEL_PORT XUI_WEB_BASE_PATH XUI_API_TOKEN
  return 0
}

load_state

cmd_info() {
  if [[ -f $RESULT ]]; then cat "$RESULT"; else echo "Результат не найден ($RESULT)."; fi
}

cmd_status() {
  echo "=== Сервисы ==="
  local s st
  for s in x-ui nginx client-sub; do
    st=inactive
    if systemctl is-active --quiet "$s" 2>/dev/null; then st=active; fi
    printf '  %-8s %s\n' "$s" "$st"
  done
  echo
  echo "=== x-ui ==="
  systemctl status x-ui --no-pager 2>&1 | head -8 || true
  echo
  echo "=== Порты ==="
  ss -tlnp 2>/dev/null | grep -E 'x-ui|xray|nginx|:443|:80' || true
  echo
  echo "=== UFW ==="
  ufw status 2>/dev/null | head -25 || true
  echo
  echo "=== Сертификаты (acme.sh) ==="
  /root/.acme.sh/acme.sh --list 2>/dev/null | head -12 || true
}

cmd_restart() {
  systemctl restart x-ui
  if [[ -f /etc/nginx/xui-stream.conf ]]; then
    systemctl reload nginx
  fi
  if [[ ${CLIENT_SUB_ACTIVE:-no} == yes ]]; then
    systemctl restart client-sub
  fi
  echo "x-ui перезапущен, nginx перезагружен."
}

cmd_links() {
  local link="${SUB_LINK:-${SUB_URL}${SUBID}}"
  echo "Подписка (все протоколы): $link"
  echo
  echo "Ссылки по протоколам:"
  curl -fsSk -m 15 -A "v2rayNG/1.8.5" "$link" 2>/dev/null | base64 -d 2>/dev/null \
    || echo "(не удалось получить подписку)"
}

cmd_routing() {
  local py="/usr/local/lib/client-sub/client_sub.py"
  local rules="/etc/client-sub/rules.yaml"
  [[ -f $py ]] || { echo "client-sub не установлен ($py)." >&2; exit 1; }

  local token="${XUI_API_TOKEN:-}"
  [[ -n $token ]] || { echo "В /etc/x-ui/install-result.env нет XUI_API_TOKEN." >&2; exit 1; }
  local port="${XUI_PANEL_PORT:-${PANEL_PORT:-}}" path="${XUI_WEB_BASE_PATH:-${PANEL_PATH:-}}"
  [[ -n $port && -n $path ]] || { echo "Не нашёл порт/путь панели в состоянии установки." >&2; exit 1; }

  local api="" scheme
  for scheme in https http; do
    api="$scheme://127.0.0.1:$port/$path/panel/api"
    if curl -fsSk -m 5 -o /dev/null -H "Authorization: Bearer $token" "$api/server/getNewUUID" 2>/dev/null; then
      break
    fi
    api=""
  done
  [[ -n $api ]] || { echo "Панель не отвечает – проверьте: xui-deployer status" >&2; exit 1; }

  local happ="" json="" enable=false
  if [[ -s $rules ]]; then
    happ=$(python3 "$py" --routing-payload happ) || { echo "rules.yaml не разобран – настройки не меняю." >&2; exit 1; }
    json=$(python3 "$py" --routing-payload json) || { echo "rules.yaml не разобран – настройки не меняю." >&2; exit 1; }
    enable=true
  fi

  local all upd
  all=$(curl -fsSk -m 25 -H "Authorization: Bearer $token" "$api/setting/all") \
    || { echo "Не удалось прочитать настройки панели." >&2; exit 1; }
  [[ $(jq -r '.success' <<<"$all") == true ]] \
    || { echo "Панель отклонила чтение настроек: $(jq -r '.msg // .' <<<"$all")" >&2; exit 1; }
  upd=$(jq -c --argjson enable "$enable" --arg happ "$happ" --arg json "$json" \
    '.obj | .subEnableRouting = $enable | .subRoutingRules = $happ | .subJsonRoutingRules = $json' <<<"$all")

  local res
  res=$(curl -fsSk -m 25 -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -X POST --data-binary "$upd" "$api/setting/update") \
    || { echo "Не удалось сохранить настройки панели." >&2; exit 1; }
  [[ $(jq -r '.success' <<<"$res") == true ]] \
    || { echo "Панель отклонила настройки: $(jq -r '.msg // .' <<<"$res")" >&2; exit 1; }

  systemctl restart x-ui
  if [[ $enable == true ]]; then
    echo "Маршрутизация из $rules применена: Happ (Routing) и JSON-подписка Xray."
  else
    echo "Файла $rules нет – маршрутизация отключена (весь трафик через VPN)."
  fi
}

backup_sqlite() {
  local src="$1" dst="$2"
  [[ -f $src ]] || return 0
  mkdir -p "$(dirname "$dst")"
  if command -v sqlite3 >/dev/null 2>&1 && sqlite3 "$src" ".backup '$dst'" >/dev/null 2>&1; then
    return 0
  fi
  if python3 - "$src" "$dst" <<'PY' >/dev/null 2>&1
import sqlite3
import sys
src, dst = sys.argv[1], sys.argv[2]
source = sqlite3.connect(f"file:{src}?mode=ro", uri=True)
target = sqlite3.connect(dst)
with target:
    source.backup(target)
target.close()
source.close()
PY
  then
    return 0
  fi
  echo "  ! согласованная копия БД не удалась, копирую файлы как есть" >&2
  cp -a "$src" "$dst" 2>/dev/null || true
  cp -a "$src-wal" "$dst-wal" 2>/dev/null || true
  cp -a "$src-shm" "$dst-shm" 2>/dev/null || true
}

BACKUP_PACKAGES=(curl jq openssl qrencode ca-certificates iproute2 ufw socat cron unzip python3 python3-yaml nginx libnginx-mod-stream)

write_restore_script() {
  local out="$1"
  {
    printf '#!/usr/bin/env bash\nset -euo pipefail\n\n'
    printf 'XUI_VERSION=%q\n' "${XUI_VERSION:-v3.11.0}"
    printf 'XUI_INSTALL_SHA256=%q\n' "$XUI_INSTALL_SHA256"
    printf 'ARCHIVE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"\n'
    cat <<'RESTORE'

[[ $EUID -eq 0 ]] || { echo "Запустите от root: sudo bash restore.sh" >&2; exit 1; }
command -v apt-get >/dev/null 2>&1 || { echo "Нужен Debian/Ubuntu (apt-get)" >&2; exit 1; }

echo "==> Пакеты"
mapfile -t PACKAGES < <(awk -F'\t' 'NF >= 1 {print $1}' "$ARCHIVE_DIR/packages.txt")
if [[ ${#PACKAGES[@]} -gt 0 ]]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || true
  apt-get install -y -qq "${PACKAGES[@]}"
fi

echo "==> 3X-UI $XUI_VERSION"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp" "https://raw.githubusercontent.com/MHSanaei/3x-ui/${XUI_VERSION}/install.sh"
got=$(sha256sum "$tmp" | awk '{print $1}')
[[ $got == "$XUI_INSTALL_SHA256" ]] || { echo "SHA256 установщика не совпал" >&2; exit 1; }
XUI_NONINTERACTIVE=1 XUI_SSL_MODE=none XUI_SERVER_IP=127.0.0.1 bash "$tmp" "$XUI_VERSION" </dev/null || true
rm -f "$tmp"

echo "==> Файлы"
cp -a "$ARCHIVE_DIR/payload/." /
systemctl daemon-reload
systemctl enable x-ui nginx >/dev/null 2>&1 || true
if [[ -f /etc/systemd/system/client-sub.service ]]; then
  systemctl enable client-sub >/dev/null 2>&1 || true
fi
systemctl restart x-ui || true
systemctl restart nginx || true
if [[ -f /etc/systemd/system/client-sub.service ]]; then
  systemctl restart client-sub || true
fi
if [[ -x /root/.acme.sh/acme.sh ]]; then
  /root/.acme.sh/acme.sh --install-cronjob >/dev/null 2>&1 || true
fi

echo "==> Готово: проверьте xui-deployer status, DNS A-записи и выпуск сертификатов"
RESTORE
  } > "$out"
  chmod 700 "$out"
}

cmd_backup() {
  local mode="${1:-config}" full=no
  case "$mode" in
    ""|config|--config) full=no ;;
    --full|full) full=yes ;;
    *) echo "Неизвестный режим backup: $mode (используйте --full)" >&2; exit 1 ;;
  esac

  local ts out tmp payload
  ts=$(date -u +%Y%m%d-%H%M%S)
  if [[ $full == yes ]]; then
    out="/root/xui-deployer-full-$ts.tar.gz"
  else
    out="/root/xui-deployer-backup-$ts.tar.gz"
  fi
  tmp=$(mktemp -d)
  payload="$tmp/payload"
  mkdir -p "$payload/etc/x-ui" "$payload/etc/xui-deployer" "$payload/etc/client-sub" \
    "$payload/etc/nginx/conf.d" "$payload/etc/nginx/modules-enabled" \
    "$payload/etc/systemd/system/ssh.socket.d" "$payload/root/cert" "$payload/root/.acme.sh"

  backup_sqlite /etc/x-ui/x-ui.db "$payload/etc/x-ui/x-ui.db"
  cp -a /etc/x-ui/install-result.env "$payload/etc/x-ui/" 2>/dev/null || true
  cp -a "$STATE_JSON" "$payload/etc/xui-deployer/" 2>/dev/null || true
  cp -a "$STATE_ENV" "$payload/etc/xui-deployer/" 2>/dev/null || true
  cp -a /etc/client-sub/config.json "$payload/etc/client-sub/" 2>/dev/null || true
  cp -a /etc/client-sub/rules.yaml "$payload/etc/client-sub/" 2>/dev/null || true
  cp -a /etc/client-sub/sni-grace.json "$payload/etc/client-sub/" 2>/dev/null || true
  cp -a /etc/nginx/nginx.conf "$payload/etc/nginx/" 2>/dev/null || true
  cp -a /etc/nginx/xui-stream.conf "$payload/etc/nginx/" 2>/dev/null || true
  cp -a /etc/nginx/conf.d/xui-front.conf "$payload/etc/nginx/conf.d/" 2>/dev/null || true
  cp -a /etc/nginx/modules-enabled/. "$payload/etc/nginx/modules-enabled/" 2>/dev/null || true
  cp -a /etc/systemd/system/client-sub.service "$payload/etc/systemd/system/" 2>/dev/null || true
  cp -a /etc/systemd/system/ssh.socket.d/override.conf "$payload/etc/systemd/system/ssh.socket.d/" 2>/dev/null || true
  cp -a "$RESULT" "$payload/root/" 2>/dev/null || true
  cp -a /root/cert/. "$payload/root/cert/" 2>/dev/null || true
  cp -a /root/.acme.sh/. "$payload/root/.acme.sh/" 2>/dev/null || true

  if [[ $full == yes ]]; then
    mkdir -p "$payload/usr/local/lib/client-sub" "$payload/usr/local/bin"
    cp -a /usr/local/lib/client-sub/client_sub.py "$payload/usr/local/lib/client-sub/" 2>/dev/null || true
    cp -a /usr/local/bin/xui-deployer "$payload/usr/local/bin/" 2>/dev/null || true
    dpkg-query -W -f='${Package}\t${Version}\n' "${BACKUP_PACKAGES[@]}" > "$tmp/packages.txt" 2>/dev/null || true
    {
      printf 'Создано: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf 'Хост: %s\n' "$HOST"
      printf '3X-UI: %s (sha256 установщика %s)\n' "$XUI_VERSION" "$XUI_INSTALL_SHA256"
      uname -a
      grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release 2>/dev/null || true
      if command -v nginx >/dev/null 2>&1; then nginx -V 2>&1; fi
      openssl version 2>/dev/null || true
      python3 -V 2>&1 || true
    } > "$tmp/manifest.txt"
    write_restore_script "$tmp/restore.sh"
  fi

  tar -czf "$out" -C "$tmp" .
  rm -rf "$tmp"
  chmod 600 "$out"
  if [[ $full == yes ]]; then
    echo "Полная резервная копия: $out"
    echo "Внутри: БД, конфиги, сертификаты и acme.sh, client_sub.py, unit-файлы, /usr/local/bin/xui-deployer,"
    echo "        modules-enabled, список пакетов, manifest.txt и restore.sh."
    echo "Восстановление: mkdir -p /tmp/restore && tar -xzf $out -C /tmp/restore && sudo bash /tmp/restore/restore.sh"
  else
    echo "Резервная копия конфигурации: $out"
    echo "Внутри: БД (согласованная копия), /etc/x-ui, /etc/xui-deployer, /etc/client-sub,"
    echo "        /etc/nginx (nginx.conf, stream, фронт, modules-enabled), unit client-sub,"
    echo "        SSH override, /root/cert и /root/.acme.sh."
    echo "Восстановление: на чистом VPS поставьте ту же версию (get.sh), затем"
    echo "  mkdir -p /tmp/restore && tar -xzf $out -C /tmp/restore && cp -a /tmp/restore/payload/. /"
    echo "  и перезапустите x-ui, nginx, client-sub. Полный вариант: xui-deployer backup --full."
  fi
}

case "${1:-help}" in
  info)    cmd_info ;;
  status)  cmd_status ;;
  restart) cmd_restart ;;
  routing|rules) cmd_routing ;;
  links)   cmd_links ;;
  backup)  cmd_backup "${2:-}" ;;
  help|-h|--help)
    cat <<EOF
xui-deployer – управление панелью
  info      реквизиты и ссылки (из /root/xui-deployer.txt)
  status    состояние сервисов, порты, файрвол, сертификаты
  links     ссылка подписки и её содержимое (ссылки по протоколам)
  restart   перезапустить x-ui, nginx и client-sub
  routing   применить /etc/client-sub/rules.yaml к Happ и JSON-подписке
  backup           резервная копия конфигурации (БД, сертификаты, конфиги) в /root
  backup --full    полный disaster recovery: файлы сервисов, список пакетов, restore.sh
EOF
    ;;
  *) echo "Неизвестная команда: $1 (см. xui-deployer help)" >&2; exit 1 ;;
esac